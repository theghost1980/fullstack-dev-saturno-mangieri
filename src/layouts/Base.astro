---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/merriweather/latin-300-italic.css";
import "@fontsource/montserrat/latin-800.css";
import "@fontsource/fira-code/latin-600.css";
import "../styles/global.css";
import { languages, pathFor, ogImageFor, ogLocales, type Lang } from "../i18n";
import { useUI } from "../i18n/ui";
import { site } from "../data/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = useUI(lang);
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  description: ui.meta.description,
  url: abs(pathFor(lang)),
  sameAs: [site.linkedin, site.github].filter(Boolean),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ui.meta.title}</title>
    <meta name="description" content={ui.meta.description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={abs(pathFor(lang))} />
    {Object.keys(languages).map((l) => <link rel="alternate" hreflang={l} href={abs(pathFor(l as Lang))} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={ui.meta.title} />
    <meta property="og:description" content={ui.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={abs(pathFor(lang))} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {Object.keys(languages).filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocales[l as Lang]} />)}
    <meta property="og:image" content={abs(ogImageFor(lang))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, "\\u003c")} />
    <!-- Apply the saved theme before the page paints, to avoid a flash. -->
    <script is:inline>
      try { const t = localStorage.getItem("theme"); if (t === "dark" || t === "light") document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <!-- Gradient used by the logo badge (referenced from CSS). -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" class="logo-stop-a"></stop><stop offset="100%" class="logo-stop-b"></stop></linearGradient>
      </defs>
    </svg>
    <slot />
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
