---
/* The whole page. Both languages render this same component. */
import { type Lang } from "../i18n";
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Stats from "./Stats.astro";
import Work from "./Work.astro";
import Services from "./Services.astro";
import Process from "./Process.astro";
import Experience from "./Experience.astro";
import Approach from "./Approach.astro";
import Partners from "./Partners.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import Alter from "./Alter.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang}>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Stats lang={lang} />
    <Work lang={lang} />
    <Services lang={lang} />
    <Process lang={lang} />
    <Experience lang={lang} />
    <Approach lang={lang} />
    <Partners lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <Alter lang={lang} />
</Base>
